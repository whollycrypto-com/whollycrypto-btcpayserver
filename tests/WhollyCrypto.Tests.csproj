<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BTCPayServerDir Condition="'$(BTCPayServerDir)' == ''">$(MSBuildThisFileDirectory)../submodules/btcpayserver</BTCPayServerDir>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../src/BTCPayServer.Plugins.WhollyCrypto/BTCPayServer.Plugins.WhollyCrypto.csproj" />
    <ProjectReference Include="$(BTCPayServerDir)/BTCPayServer/BTCPayServer.csproj" Properties="StaticWebAssetsEnabled=false" />
  </ItemGroup>
</Project>
